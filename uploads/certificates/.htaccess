# Disable PHP engine and script execution in the certificates uploads folder
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Prevent direct execution of any script files
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|cgi|asp|aspx|sh|bash|exe)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
Options -Indexes -ExecCGI
